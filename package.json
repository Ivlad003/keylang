{
  "name": "keylang",
  "version": "0.5.0",
  "description": "Architecture description in Markdown, bound to the repository: map, rules, flows, checked against the code",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ivlad003/keylang.git"
  },
  "homepage": "https://github.com/Ivlad003/keylang#readme",
  "bugs": "https://github.com/Ivlad003/keylang/issues",
  "keywords": [
    "architecture",
    "markdown",
    "dependency-rules",
    "code-map",
    "tree-sitter",
    "cli",
    "mcp"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "keylang": "./bin/keylang.js"
  },
  "files": [
    "adapters",
    "bin",
    "dist",
    "dist/wasm",
    "resources"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-wasm.mjs && node scripts/copy-web.mjs && node scripts/pack-entry.mjs publish",
    "postpack": "node scripts/pack-entry.mjs restore",
    "test": "node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./src/adapters/node-test.ts --test-reporter-destination=stdout tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "keylang": "node bin/keylang.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "6.0.0",
    "fast-check": "^4.10.2",
    "mdast-util-from-markdown": "^2.0.3",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "eventsource-parser": "^4.1.1",
    "smol-toml": "^1.9.0",
    "web-tree-sitter": "^0.27.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "exports": {
    ".": "./dist/index.js",
    "./node-test-reporter": "./dist/adapters/node-test.js",
    "./trace": "./dist/adapters/trace.js",
    "./package.json": "./package.json"
  },
  "optionalDependencies": {
    "@fugood/whisper.node": "^1.1.3",
    "decibri": "^5.7.0"
  }
}
