{
  "$comment": "Outgoing integrations for `keylang integrations` (business-flows/14): HTTP clients, SOAP, vendor SDKs and queue clients. An entry matches a call by `callees` (regular expressions over the callee as the facts write it), `imports` (a name an import of that package, module or class binds, or a crate path; `methods` narrows to those last names) or `receivers` (the receiver's class); `languages` limits it; `kind` is http, soap, sdk, payment or queue. Data, not code: add a client here, not in src/.",
  "integrations": [
    { "id": "guzzle", "label": "Guzzle HTTP client", "kind": "http", "languages": ["php"], "imports": ["GuzzleHttp\\"] },
    { "id": "magento-http-client", "label": "Magento HTTP client (Magento\\Framework\\HTTP\\Client\\Curl)", "kind": "http", "languages": ["php"], "imports": ["Magento\\Framework\\HTTP\\Client\\", "Magento\\Framework\\HTTP\\ClientInterface", "Magento\\Framework\\HTTP\\ClientFactory", "Magento\\Framework\\HTTP\\Adapter\\", "Magento\\Framework\\HTTP\\ZendClient", "Magento\\Framework\\HTTP\\LaminasClient"] },
    { "id": "magento-payment-gateway", "label": "Magento payment gateway HTTP client", "kind": "payment", "languages": ["php"], "imports": ["Magento\\Payment\\Gateway\\Http\\ClientInterface", "Magento\\Payment\\Gateway\\Http\\Client\\", "Magento\\Payment\\Gateway\\Http\\TransferFactoryInterface"], "methods": ["placeRequest", "create"] },
    { "id": "laminas-http", "label": "Laminas / Zend HTTP client", "kind": "http", "languages": ["php"], "imports": ["Laminas\\Http\\", "Zend\\Http\\", "Zend_Http_Client"] },
    { "id": "symfony-http-client", "label": "Symfony HttpClient", "kind": "http", "languages": ["php"], "imports": ["Symfony\\Component\\HttpClient\\", "Symfony\\Contracts\\HttpClient\\"] },
    { "id": "laravel-http", "label": "Laravel Http facade", "kind": "http", "languages": ["php"], "imports": ["Illuminate\\Support\\Facades\\Http", "Illuminate\\Http\\Client\\"], "callees": ["^Http(::|\\.)(get|post|put|patch|delete|send|withHeaders|withToken|acceptJson|asForm|baseUrl|pool)$"] },
    { "id": "php-curl", "label": "PHP cURL", "kind": "http", "languages": ["php"], "callees": ["^curl_(init|exec|multi_exec)$"] },
    { "id": "soap", "label": "SOAP client", "kind": "soap", "languages": ["php"], "callees": ["^\\\\?SoapClient$"], "imports": ["SoapClient", "Laminas\\Soap\\Client", "Zend\\Soap\\Client", "Magento\\Framework\\Webapi\\Soap\\ClientFactory"] },
    { "id": "stripe", "label": "Stripe SDK", "kind": "payment", "imports": ["Stripe\\", "stripe", "@stripe/*", "stripe::"] },
    { "id": "paypal", "label": "PayPal SDK", "kind": "payment", "imports": ["PayPal\\", "PayPalCheckoutSdk\\", "PaypalServerSdkLib\\", "@paypal/*", "paypal-rest-sdk", "paypalrestsdk", "paypalcheckoutsdk"] },
    { "id": "braintree", "label": "Braintree SDK", "kind": "payment", "imports": ["Braintree\\", "braintree"] },
    { "id": "adyen", "label": "Adyen SDK", "kind": "payment", "imports": ["Adyen\\", "@adyen/*", "Adyen"] },
    { "id": "avalara", "label": "Avalara AvaTax (tax)", "kind": "sdk", "imports": ["Avalara\\", "avatax", "Avalara"] },
    { "id": "vertex", "label": "Vertex (tax)", "kind": "sdk", "imports": ["Vertex\\", "VertexInc\\"] },
    { "id": "aws-sdk", "label": "AWS SDK", "kind": "sdk", "imports": ["Aws\\", "@aws-sdk/*", "aws-sdk", "boto3", "botocore", "aws_sdk_*", "aws_config"] },
    { "id": "twilio", "label": "Twilio SDK", "kind": "sdk", "imports": ["Twilio\\", "twilio"] },
    { "id": "sendgrid", "label": "SendGrid SDK", "kind": "sdk", "imports": ["SendGrid\\", "SendGrid", "@sendgrid/*", "sendgrid"] },
    { "id": "fetch", "label": "fetch", "kind": "http", "languages": ["typescript", "javascript"], "callees": ["^(globalThis\\.|window\\.)?fetch$"], "imports": ["node-fetch", "cross-fetch", "isomorphic-fetch"] },
    { "id": "axios", "label": "axios", "kind": "http", "languages": ["typescript", "javascript"], "imports": ["axios"] },
    { "id": "got", "label": "got", "kind": "http", "languages": ["typescript", "javascript"], "imports": ["got", "ky", "superagent", "undici"] },
    { "id": "node-http", "label": "Node.js http/https", "kind": "http", "languages": ["typescript", "javascript"], "imports": ["node:http", "node:https", "http", "https"], "methods": ["request", "get"] },
    { "id": "requests", "label": "requests", "kind": "http", "languages": ["python"], "imports": ["requests"] },
    { "id": "httpx", "label": "httpx", "kind": "http", "languages": ["python"], "imports": ["httpx", "aiohttp"] },
    { "id": "urllib", "label": "urllib.request", "kind": "http", "languages": ["python"], "imports": ["urllib.request", "urllib3"], "methods": ["urlopen", "Request", "request", "PoolManager"] },
    { "id": "python-soap", "label": "Python SOAP client (zeep, suds)", "kind": "soap", "languages": ["python"], "imports": ["zeep", "suds"] },
    { "id": "reqwest", "label": "reqwest", "kind": "http", "languages": ["rust"], "imports": ["reqwest", "ureq", "surf"] },
    { "id": "hyper", "label": "hyper", "kind": "http", "languages": ["rust"], "imports": ["hyper", "hyper_util"] },
    { "id": "magento-queue", "label": "Magento message queue publisher", "kind": "queue", "languages": ["php"], "imports": ["Magento\\Framework\\MessageQueue\\PublisherInterface"], "receivers": ["PublisherInterface"], "methods": ["publish"] },
    { "id": "php-amqp", "label": "php-amqplib", "kind": "queue", "languages": ["php"], "imports": ["PhpAmqpLib\\"], "methods": ["basic_publish"] },
    { "id": "symfony-messenger", "label": "Symfony Messenger", "kind": "queue", "languages": ["php"], "imports": ["Symfony\\Component\\Messenger\\MessageBusInterface"], "receivers": ["MessageBusInterface"], "methods": ["dispatch"] },
    { "id": "amqp", "label": "AMQP client (amqplib, pika, lapin)", "kind": "queue", "imports": ["amqplib", "amqp-connection-manager", "pika", "aio_pika", "lapin"], "methods": ["publish", "sendToQueue", "basic_publish", "basic_publish_with_properties"] },
    { "id": "kafka", "label": "Kafka client", "kind": "queue", "imports": ["kafkajs", "kafka", "confluent_kafka", "aiokafka", "rdkafka"], "methods": ["send", "produce", "send_and_wait"] },
    { "id": "bullmq", "label": "BullMQ / Bull", "kind": "queue", "languages": ["typescript", "javascript"], "imports": ["bullmq", "bull"], "methods": ["add", "addBulk"] },
    { "id": "celery", "label": "Celery", "kind": "queue", "languages": ["python"], "imports": ["celery"], "methods": ["send_task", "delay", "apply_async"] }
  ]
