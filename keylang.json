{
  "languages": ["typescript", "javascript"],
  "module": "file",
  "layers": {
    "cli": ["bin/**", "src/cli.ts", "src/index.ts", "src/lsp.ts", "src/adapters/**"],
    "tui": ["src/tui/**"],
    "features": ["src/lsp-features.ts", "src/explain.ts"],
    "map": ["src/map.ts", "src/emit.ts", "src/graph.ts", "src/imports.ts", "src/snapshot.ts", "src/analyze.ts", "src/fact-cache.ts"],
    "check": ["src/rules.ts", "src/resolve.ts", "src/scc.ts", "src/verdict.ts", "src/flows.ts", "src/assess.ts", "src/test-report.ts", "src/trace-evidence.ts"],
    "lang": ["src/parser.ts", "src/fmt.ts", "src/files.ts", "src/ir.ts"],
    "extract": ["src/extract/**"],
    "base": ["src/span.ts", "src/diag.ts", "src/config.ts", "src/glob.ts"]
  },
  "exclude": ["bench/**", "examples/**", "design/**", "slides/**", "scripts/**", "editors/**"],
  "check": {
    "tests": ".keylang/reports/*.json",
    "trace": ".keylang/trace/*.jsonl"
  }
}
